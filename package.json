{
  "name": "nuxt-starter",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "nuxt-starter",
  "author": "oiij",
  "license": "MIT",
  "homepage": "https://github.com/oiij/nuxt-starter",
  "scripts": {
    "dev": "nuxt dev --host",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "update:deps": "taze -w && pnpm i",
    "type:check": "nuxt typecheck",
    "cz": "czg",
    "commit": "git pull && git add -A && pnpm cz && git push",
    "pull": "git checkout -- . && git pull origin main",
    "release": "pnpm pull && pnpm build",
    "awe": "pnpx are-we-esm",
    "nmi": "pnpx node-modules-inspector",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks && nuxt prepare"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@iconify-json/mage": "^1.2.4",
    "@nuxt/content": "^3.13.0",
    "@nuxt/devtools": "4.0.0-alpha.4",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "10.3.0",
    "@oiij/tsconfig": "^0.0.4",
    "@oiij/unocss-preset": "^0.0.1",
    "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@plugin-web-update-notification/vite": "^2.1.0",
    "@types/node": "^25.6.2",
    "@unhead/vue": "^3.1.0",
    "@unocss/eslint-config": "66.6.8",
    "@unocss/eslint-plugin": "66.6.8",
    "@unocss/nuxt": "66.6.8",
    "@unocss/reset": "66.6.8",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/ui": "^4.1.5",
    "@vue-hooks-plus/resolvers": "^1.3.0",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "await-to-js": "^3.0.0",
    "axios": "^1.16.0",
    "colord": "^2.9.3",
    "commitlint": "^21.0.0",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "es-toolkit": "^1.46.1",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^29.1.1",
    "less": "^4.6.4",
    "lint-staged": "^17.0.4",
    "naive-ui": "^2.44.1",
    "nanoid": "^5.1.11",
    "notivue": "^2.4.5",
    "nuxt": "^4.4.4",
    "nuxt-content-twoslash": "^0.4.0",
    "nuxt-icons": "^4.0.0",
    "nuxt-shiki": "^0.3.2",
    "nuxt-viewport": "^2.4.0",
    "postcss": "^8.5.14",
    "postcss-preset-env": "^11.2.1",
    "shiki": "^4.0.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0",
    "taze": "^19.11.0",
    "typescript": "^6.0.3",
    "unocss": "66.6.8",
    "unocss-preset-animatecss": "^0.0.2",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-extra": "^1.0.0",
    "unocss-preset-scrollbar": "^4.0.0",
    "unocss-preset-theme": "^0.14.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-info": "^1.3.2",
    "vfonts": "^0.0.3",
    "vite": "^8.0.11",
    "vite-plugin-version-mark": "^0.2.2",
    "vite-plugin-webfont-dl": "^3.12.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.34",
    "vue-hooks-plus": "2.4.3",
    "vue-router": "^5.0.6",
    "vue-tsc": "^3.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm type:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm lint:fix"
    ]
  }
}
